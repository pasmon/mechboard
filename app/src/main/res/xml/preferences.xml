<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Master on/off toggle -->
    <SwitchPreferenceCompat
        android:key="sound_enabled"
        android:title="@string/pref_sound_enabled_title"
        android:summary="@string/pref_sound_enabled_summary"
        android:defaultValue="true" />

    <!-- Sound profile chooser -->
    <ListPreference
        android:key="sound_profile"
        android:title="@string/pref_sound_profile_title"
        android:defaultValue="cherry_blue"
        android:dependency="sound_enabled"
        app:useSimpleSummaryProvider="true" />

    <!-- Keyboard language chooser -->
    <ListPreference
        android:key="keyboard_layout"
        android:title="@string/pref_keyboard_layout_title"
        android:defaultValue="english"
        app:useSimpleSummaryProvider="true" />

    <!-- Capital letter at the start of sentences, where the text field asks for it -->
    <SwitchPreferenceCompat
        android:key="auto_capitalize"
        android:title="@string/pref_auto_capitalize_title"
        android:summary="@string/pref_auto_capitalize_summary"
        android:defaultValue="true" />

    <!-- Word completions above the keys -->
    <SwitchPreferenceCompat
        android:key="word_suggestions"
        android:title="@string/pref_word_suggestions_title"
        android:summary="@string/pref_word_suggestions_summary"
        android:defaultValue="true" />

    <!-- Opt-in: a space or punctuation corrects a clear typo -->
    <SwitchPreferenceCompat
        android:key="autocorrect"
        android:title="@string/pref_autocorrect_title"
        android:summary="@string/pref_autocorrect_summary"
        android:defaultValue="false"
        android:dependency="word_suggestions" />

    <!-- Opens PersonalDictionaryFragment: the words the user saved -->
    <Preference
        android:key="personal_dictionary"
        android:title="@string/pref_personal_dictionary_title"
        android:summary="@string/pref_personal_dictionary_summary"
        app:fragment="io.github.pasmon.mechboard.PersonalDictionaryFragment" />

    <!-- Next-word prediction learned from typing, kept on the phone -->
    <SwitchPreferenceCompat
        android:key="learn_word_pairs"
        android:title="@string/pref_learn_word_pairs_title"
        android:summary="@string/pref_learn_word_pairs_summary"
        android:defaultValue="true" />

    <!-- Asks for confirmation, then forgets the learned word pairs -->
    <Preference
        android:key="clear_learned_words"
        android:title="@string/pref_clear_learned_words_title"
        android:summary="@string/pref_clear_learned_words_summary" />

    <!-- Keyboard theme chooser -->
    <ListPreference
        android:key="keyboard_theme"
        android:title="@string/pref_keyboard_theme_title"
        android:defaultValue="dark"
        app:useSimpleSummaryProvider="true" />

    <!-- Keyboard font chooser -->
    <ListPreference
        android:key="keyboard_font"
        android:title="@string/pref_keyboard_font_title"
        android:defaultValue="default"
        app:useSimpleSummaryProvider="true" />

    <!-- Volume (0–100) -->
    <SeekBarPreference
        android:key="volume"
        android:title="@string/pref_volume_title"
        android:summary="@string/pref_volume_summary"
        android:defaultValue="80"
        android:min="0"
        android:max="100"
        android:dependency="sound_enabled" />

</PreferenceScreen>
