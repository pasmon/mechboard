<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and transfer rules for Android 12 and later (android:dataExtractionRules).
    The word pairs learned from typing stay on the phone: they are neither
    backed up to the cloud nor copied to a new device. Everything else is.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="learned_word_pairs.txt" />
        <exclude domain="file" path="learned_word_pairs.txt.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="learned_word_pairs.txt" />
        <exclude domain="file" path="learned_word_pairs.txt.tmp" />
    </device-transfer>
</data-extraction-rules>
