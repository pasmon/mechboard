<?xml version="1.0" encoding="utf-8"?>
<!--
    PersonalDictionaryFragment: a field and button to add a word, and the list of
    saved words, each with a delete button. The empty message replaces the list
    while no words are saved.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/new_word"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:hint="@string/personal_dictionary_hint"
            android:imeOptions="actionDone"
            android:inputType="text|textNoSuggestions"
            android:maxLength="48"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/add_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/personal_dictionary_add" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:text="@string/personal_dictionary_empty"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <ListView
        android:id="@+id/word_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>
